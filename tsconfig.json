{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "moduleDetection": "auto",
    "rootDir": "src",
    "outDir": "dist",
    "removeComments": false,
    "newLine": "lf"
  },
  "files": ["src/keywords.ts", "src/content.ts", "src/popup.ts"]
}
