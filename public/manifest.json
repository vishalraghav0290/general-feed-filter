{
  "manifest_version": 3,
  "name": "X Feed Filter",
  "version": "1.0.1",
  "description": "Keep only the posts you care about in your X (Twitter) For You feed, using your own keywords. Ships with an aviation preset. Runs on-device.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["keywords.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Feed Filter"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
